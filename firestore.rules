rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function validProfile(data, uid) {
      return data.keys().hasOnly([
        'uid', 'displayName', 'handle', 'photoURL', 'bio', 'createdAt', 'updatedAt'
      ])
      && data.uid == uid
      && data.displayName is string && data.displayName.size() <= 60
      && data.handle is string && data.handle.size() <= 30
      && data.bio is string && data.bio.size() <= 300;
    }
    function validVideo(data) {
      return data.keys().hasOnly([
        'ownerUid', 'title', 'description', 'type', 'category',
        'storagePath', 'videoUrl', 'thumbnailPath', 'status', 'createdAt', 'updatedAt'
      ])
      && data.ownerUid == request.auth.uid
      && data.title is string && data.title.size() > 0 && data.title.size() <= 100
      && data.description is string && data.description.size() <= 1000
      && data.type in ['short', 'long']
      && data.category is string && data.category.size() <= 40
      && data.storagePath is string
      && data.storagePath.matches('users/' + request.auth.uid + '/videos/.*')
      && data.videoUrl is string && data.videoUrl.size() <= 2048
      && data.status in ['draft', 'published'];
    }
    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validProfile(request.resource.data, uid);
      allow update: if owns(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // A user controls only their own block list.
      match /blocks/{blockedUid} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && blockedUid != uid
          && request.resource.data.keys().hasOnly(['blockedUid', 'createdAt'])
          && request.resource.data.blockedUid == blockedUid
          && request.resource.data.createdAt == request.time;
        allow delete: if owns(uid);
        allow update: if false;
      }
    }

    // Reports are submitted by signed-in users. Review and resolution are
    // reserved for a trusted server using the Firebase Admin SDK.
    match /moderationReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'targetType', 'targetId', 'reason', 'details',
          'status', 'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['video', 'comment', 'user']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 200
        && request.resource.data.reason in [
          'spam', 'harassment', 'hate', 'sexual_content',
          'dangerous_content', 'violence', 'privacy', 'copyright', 'other'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /videos/{videoId} {
      allow read: if (signedIn() && resource.data.ownerUid == request.auth.uid)
        || resource.data.status == 'published';
      allow create: if signedIn() && validVideo(request.resource.data)
        && request.resource.data.status == 'draft'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validVideo(request.resource.data)
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      match /comments/{commentId} {
        function parentVisible() {
          return get(/databases/$(database)/documents/videos/$(videoId)).data.status == 'published'
            || get(/databases/$(database)/documents/videos/$(videoId)).data.ownerUid == request.auth.uid;
        }
        allow read: if signedIn() && parentVisible();
        allow create: if signedIn() && parentVisible()
          && request.resource.data.keys().hasOnly(['ownerUid', 'text', 'createdAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.keys().hasOnly(['ownerUid', 'text', 'createdAt']);
        allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      }
      match /likes/{uid} {
        function parentIsPublished() {
          return get(/databases/$(database)/documents/videos/$(videoId)).data.status == 'published';
        }
        allow read: if signedIn() && (
          parentIsPublished()
          || get(/databases/$(database)/documents/videos/$(videoId)).data.ownerUid == request.auth.uid
        );
        allow create: if owns(uid)
          && parentIsPublished()
          && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
          && request.resource.data.ownerUid == uid
          && request.resource.data.createdAt == request.time;
        allow delete: if owns(uid)
          && (parentIsPublished()
            || get(/databases/$(database)/documents/videos/$(videoId)).data.ownerUid == request.auth.uid);
        allow update: if false;
      }
    }
  }
}