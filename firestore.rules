rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function validVideo(data) {
      return data.keys().hasOnly([
        'ownerUid', 'title', 'description', 'type', 'category',
        'storagePath', 'thumbnailPath', 'status', 'createdAt', 'updatedAt'
      ])
      && data.ownerUid == request.auth.uid
      && data.title is string && data.title.size() > 0 && data.title.size() <= 100
      && data.description is string && data.description.size() <= 1000
      && data.type in ['short', 'long']
      && data.category is string && data.category.size() <= 40
      && data.storagePath is string
      && data.storagePath.matches('users/' + request.auth.uid + '/videos/.*')
      && data.status in ['draft', 'published'];
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'handle', 'photoURL', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.handle is string
        && request.resource.data.handle.size() <= 30
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300;
      allow delete: if false;
    }

    match /videos/{videoId} {
      allow read: if (signedIn() && resource.data.ownerUid == request.auth.uid)
        || resource.data.status == 'published';
      allow create: if signedIn() && validVideo(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validVideo(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /comments/{commentId} {
        function parentVisible() {
          return get(/databases/$(database)/documents/videos/$(videoId)).data.status == 'published'
            || get(/databases/$(database)/documents/videos/$(videoId)).data.ownerUid == request.auth.uid;
        }
        allow read: if signedIn() && parentVisible();
        allow create: if signedIn() && parentVisible()
          && request.resource.data.keys().hasOnly(['ownerUid', 'text', 'createdAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      match /likes/{uid} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/videos/$(videoId)).data.status == 'published'
          || get(/databases/$(database)/documents/videos/$(videoId)).data.ownerUid == request.auth.uid
        );
        allow create: if owns(uid)
          && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
          && request.resource.data.ownerUid == uid
          && request.resource.data.createdAt == request.time;
        allow delete: if owns(uid);
        allow update: if false;
      }
    }
  }
}